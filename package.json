{
  "name": "everplay",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "library:fetch": "python3 scripts/library/fetch_fma.py",
    "library:kit": "node scripts/library/synth_kit.mjs",
    "library:freesound": "node scripts/library/fetch_freesound.mjs",
    "library:ingest": "node --experimental-strip-types --no-warnings scripts/library/ingest.mjs",
    "library:youtube": "python3 scripts/library/fetch_youtube.py",
    "library:collection": "python3 scripts/library/build_collection.py scripts/library/collections/indian.seeds.txt --skip scripts/library/collections/hindi.txt --out hi=scripts/library/collections/hindi_wide.txt:3500 --out pa=scripts/library/collections/punjabi.txt:2000",
    "library:hindi": "python3 scripts/library/fetch_youtube.py --queries scripts/library/collections/hindi.txt scripts/library/collections/hindi_wide.txt --language hi --tags hindi --workers 2",
    "library:punjabi": "python3 scripts/library/fetch_youtube.py --queries scripts/library/collections/punjabi.txt --language pa --tags punjabi --workers 2",
    "library:import-cache": "python3 scripts/library/import_cache.py",
    "library:build": "bash scripts/library/build_all.sh",
    "library:grow": "bash scripts/library/grow_fma.sh",
    "library:push": "bash scripts/library/sync_s3.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "next": "16.2.9",
    "openai": "^6.42.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "replicate": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
